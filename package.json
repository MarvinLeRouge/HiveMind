{
  "name": "hivemind",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20.0.0",
    "pnpm": ">=9.0.0"
  },
  "scripts": {
    "lint": "pnpm -r lint",
    "test": "pnpm -r test",
    "test:e2e": "playwright test",
    "build": "pnpm -r build",
    "prepare": "husky"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "@playwright/test": "^1.61.1",
    "eslint": "^9.39.4",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-vue": "^9.33.0",
    "husky": "^9.1.7",
    "lint-staged": "^15.5.2",
    "prettier": "^3.9.4",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.63.0"
  },
  "lint-staged": {
    "apps/api/**/*.ts": [
      "eslint --fix",
      "prettier --write",
      "pnpm --filter api typecheck"
    ],
    "apps/web/**/*.{ts,vue}": [
      "eslint --fix",
      "prettier --write",
      "pnpm --filter web typecheck"
    ],
    "packages/**/*.ts": [
      "eslint --fix",
      "prettier --write"
    ]
  },
  "packageManager": "pnpm@9.15.4",
  "pnpm": {
    "overrides": {
      "fast-jwt": ">=6.2.4",
      "fast-uri": ">=3.1.1",
      "postcss@<8.5.10": ">=8.5.10",
      "fast-xml-builder@<=1.1.6": ">=1.1.7",
      "fast-xml-builder@=1.1.5": ">=1.1.6",
      "ws@>=8.0.0 <8.20.1": ">=8.20.1",
      "js-cookie@<=3.0.5": ">=3.0.7",
      "esbuild@>=0.27.3 <0.28.1": ">=0.28.1",
      "ws@>=8.0.0 <8.21.0": ">=8.21.0",
      "brace-expansion": ">=5.0.12",
      "fast-uri@>=3.0.0 <=3.1.3": ">=3.1.4",
      "postcss@<=8.5.11": ">=8.5.12",
      "find-my-way@<=9.6.0": ">=9.7.0",
      "@fastify/static@<=10.1.1": ">=10.1.2",
      "@fastify/static@<=10.1.0": ">=10.1.1",
      "postcss@<=8.5.22": ">=8.5.23",
      "fast-uri@>=3.0.0 <3.1.5": ">=3.1.5",
      "js-yaml@>=4.0.0 <4.3.1": ">=4.3.1",
      "nanoid@>=4.0.0 <5.1.16": ">=5.1.16",
      "nanoid@<3.3.16": ">=3.3.16",
      "nanoid@<3.3.18": ">=3.3.18",
      "postcss@<=8.5.17": ">=8.5.18",
      "vitest@<3.2.6": ">=3.2.6",
      "deepmerge-ts@<8.0.0": ">=8.0.0",
      "postcss-selector-parser@>=6.1.0 <6.1.3": ">=6.1.3",
      "browserslist@<=4.28.6": ">=4.28.7",
      "nanoid@<3.3.12": ">=3.3.12",
      "fastify@<5.12.1": ">=5.12.1",
      "fastify@>=5.8.3 <5.12.1": ">=5.12.1",
      "fast-uri@>=3.1.3 <3.1.6": ">=3.1.6",
      "fast-uri@>=3.0.0 <3.1.6": ">=3.1.6",
      "fast-uri@>=3.1.2 <3.1.6": ">=3.1.6",
      "csv-parse@<7.0.2": ">=7.0.2",
      "vitest@>=2.1.0 <4.1.11": ">=4.1.11 <5.0.0",
      "@vitest/mocker@>=2.1.0 <4.1.11": ">=4.1.11 <5.0.0",
      "@vitest/coverage-v8@>=2.1.0 <4.1.11": ">=4.1.11 <5.0.0",
      "baseline-browser-mapping@>=2.0.0 <2.11.0": ">=2.11.0",
      "js-yaml@>=4.0.0 <4.3.2": ">=4.3.2",
      "nodemailer@<=9.1.0": ">=9.1.1",
