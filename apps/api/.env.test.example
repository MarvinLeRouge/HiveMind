# Local test environment, loaded by vitest.config.ts when apps/api/.env.test exists.
# Copy to .env.test and set the password of the dev stack database user.
# Variables already set in the shell (CI) take precedence over this file.

# Dedicated test database in the dev stack container (port published on the host).
# The test global setup refuses any database whose name does not end with "_test".
DATABASE_URL_TEST=postgresql://HiveMind:password@127.0.0.1:5434/HiveMind_test

JWT_ACCESS_SECRET=local_test_access_secret_32_chars_min
JWT_REFRESH_SECRET=local_test_refresh_secret_32_chars_min
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
NODE_ENV=test
CORS_ORIGIN=http://localhost:5173

# Same identity as the fixed test admin created by the seed, so the seed never renames it
SEED_ADMIN_USERNAME=admin-test
SEED_ADMIN_EMAIL=admin@HiveMind.local
SEED_ADMIN_PASSWORD=change_me_admin
