{
  "name": "@hivemind/api",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src tests",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "@fastify/cookie": "^11.1.5",
    "@fastify/cors": "^11.4.1",
    "@fastify/helmet": "^13.2.0",
    "@fastify/jwt": "^10.2.7",
    "@fastify/multipart": "^10.1.8",
    "@fastify/rate-limit": "^11.2.2",
    "@fastify/swagger": "^9.9.3",
    "@fastify/swagger-ui": "^5.2.5",
    "@hivemind/shared": "workspace:*",
    "@prisma/client": "^6.0.0",
    "bcryptjs": "^3.0.3",
    "csv-parse": "^7.0.3",
    "fast-xml-parser": "^5.12.0",
    "fastify": "^5.12.6",
    "fastify-plugin": "^5.1.0",
    "fastify-type-provider-zod": "^6.1.0",
    "nodemailer": "^10.5.0",
    "zod": "^4.6.7"
  },
  "prisma": {
    "seed": "node_modules/.bin/tsx prisma/seed.ts"
