  "devDependencies": {
    "@types/bcryptjs": "^3.0.0",
    "@types/node": "^22.20.5",
    "@types/nodemailer": "^8.0.2",
    "@vitest/coverage-v8": "^5.1.0",
    "prisma": "^6.0.0",
    "tsx": "^4.23.15",
