# Template for /home/mlr/marvinlerouge.dev/hivemind/shared/env/secrets.env on the VPS (chmod 600).
# Loaded into the backend (after app.env) and db containers through env_file in docker-compose.prod.yml.
# Never commit the real file. Local development keeps apps/api/.env (see apps/api/.env.example).

# Database. POSTGRES_PASSWORD initialises the db container (first start only), DATABASE_URL is read by
# Prisma in the backend: both passwords must match. User and database name are HiveMind (set in the compose file).
POSTGRES_PASSWORD=
DATABASE_URL=postgresql://HiveMind:PASSWORD@db:5432/HiveMind

# JWT signing secrets, at least 32 characters each (generate with: openssl rand -hex 32)
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=

# SMTP credentials
SMTP_USER=
SMTP_PASS=

# Admin account created by the seed
SEED_ADMIN_USERNAME=
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=

# Sentry: leave empty to disable
SENTRY_BACKEND_DSN=
SENTRY_FRONTEND_DSN=
