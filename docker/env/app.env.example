# Template for /home/mlr/marvinlerouge.dev/hivemind/shared/env/app.env on the VPS (chmod 600).
# Non-secret settings, loaded into the backend container through env_file in docker-compose.prod.yml.
# Secrets go to secrets.env (see secrets.env.example), loaded after this file so it wins.
# Local development keeps apps/api/.env (see apps/api/.env.example).

NODE_ENV=production
PORT=3000
CORS_ORIGIN=https://hivemind.marvinlerouge.dev
FRONTEND_BASE_URL=https://hivemind.marvinlerouge.dev

# Token lifetimes (the signing secrets are in secrets.env)
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# SMTP, credentials in secrets.env
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_IGNORE_TLS=false
SMTP_FROM=

# Error tracking
SENTRY_ENVIRONMENT=production
